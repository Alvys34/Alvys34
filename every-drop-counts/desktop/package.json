{
  "name": "every-drop-counts-desktop",
  "productName": "Every Drop Counts",
  "version": "0.1.0",
  "description": "EVERY DROP COUNTS - desktop (Electron) wrapper for Steam",
  "private": true,
  "main": "src/main.js",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "postinstall": "node node_modules/electron/install.js",
    "start": "electron . --dev",
    "start:placeholder": "electron . --dev --game-dir=placeholder",
    "icon": "node scripts/make-icon.mjs",
    "build:linux": "node scripts/build.mjs --platform linux",
    "build:win": "node scripts/build.mjs --platform win",
    "build:all": "node scripts/build.mjs --platform all",
    "build:placeholder": "node scripts/build.mjs --platform all --placeholder",
    "build:release": "node scripts/build.mjs --platform all --web-build",
    "smoke": "node scripts/smoke.mjs",
    "verify": "node scripts/verify.mjs",
    "check": "node --check src/main.js && node --check src/preload.js && node --check src/steam.js",
    "steam:vdf": "node scripts/steam-vdf.mjs"
  },
  "dependencies": {
    "steamworks.js": "0.4.0"
  },
  "devDependencies": {
    "@electron/asar": "4.3.2",
    "@electron/fuses": "2.1.3",
    "@electron/packager": "20.3.0",
    "electron": "45.3.1",
    "resedit": "3.1.0",
    "yazl": "3.3.1"
  }
}
